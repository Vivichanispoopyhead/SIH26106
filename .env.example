# Backend HTTP configuration
APP_ADDR=:8080
APP_ENV=development
APP_ALLOWED_ORIGINS=http://localhost:5173

# Optional Google Gemini AIML adapter. If GEMINI_API_KEY is absent, the
# backend uses the explicit AI_NOT_CONFIGURED / not_available assessment.
# Keep real keys in local/Render environment configuration only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=15s
GEMINI_MAX_INPUT_CHARS=20000

# Optional passive IP enrichment adapter. If the API key is absent, observed
# public IPs receive explicit IP_ENRICHMENT_NOT_CONFIGURED results.
# Keep real keys in local/Render environment configuration only.
IP_ENRICHMENT_API_KEY=
IP_ENRICHMENT_API_URL=
IP_ENRICHMENT_PROVIDER=http
IP_ENRICHMENT_TIMEOUT=5s
IP_ENRICHMENT_MAX_RESPONSE_BYTES=65536

# Local infrastructure configuration for docker compose. Replace these values
# in a local .env file when needed; do not commit real credentials.
POSTGRES_DB=sih26106
POSTGRES_USER=sih26106
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
REDIS_PORT=6379
